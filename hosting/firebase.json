          "type": 302
        },
        {
          "source": "/fume",
          "destination": "https://github.com/propensive/fume/releases/latest/download/install.sh",
          "type": 302
        },
        {
          "source": "/fume/**",
          "destination": "https://github.com/propensive/fume/releases/latest/download/install.sh",
