        },
        {
          "source": "/flair",
          "destination": "https://github.com/propensive/flair/releases/latest/download/install.sh",
          "type": 302
        },
        {
          "source": "/flair/**",
          "destination": "https://github.com/propensive/flair/releases/latest/download/install.sh",
          "type": 302
        },
        {
          "source": "/tel",
